# Manasitra Environment Configuration Template
# Copy this file to .env and replace placeholder values

# LLM & AI Engine (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=800

# Backend Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://www.mansitra.in,http://localhost:3000

# Safety & Feature Flags
ENABLE_ADMIN=false
SAFETY_CLASSIFICATION_ENABLED=true
ENABLE_CRISIS_ESCALATION=true
